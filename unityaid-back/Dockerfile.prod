FROM golang:1.26-alpine AS builder

WORKDIR /src

RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/unityaid-api ./cmd/api
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/unityaid-migrate ./cmd/migrate
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/unityaid-seed ./cmd/seed

FROM alpine:3.22

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata wget

COPY --from=builder /out/unityaid-api /usr/local/bin/unityaid-api
COPY --from=builder /out/unityaid-migrate /usr/local/bin/unityaid-migrate
COPY --from=builder /out/unityaid-seed /usr/local/bin/unityaid-seed
COPY migrations ./migrations
COPY seeds ./seeds

ENV APP_ENV=production \
    HTTP_PORT=8080 \
    UPLOADS_DIR=/app/uploads \
    RUN_SEEDS=false

RUN mkdir -p /app/uploads

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/api/v1/health || exit 1

CMD ["unityaid-api"]
