CLIENT_SLUG=demo-client
COMPOSE_PROJECT_NAME=unityaid_demo_client
COMPOSE_PROFILES=

APP_ENV=production
APP_VERSION=local
RELEASE_CHANNEL=stable
BACKEND_IMAGE=unityaid-backend:local
FRONTEND_IMAGE=unityaid-frontend:local
DB_SCHEMA_VERSION=local
BACKEND_BUILD_CONTEXT=../../unityaid-back
FRONTEND_BUILD_CONTEXT=../../unityaid-front
PUBLIC_BASE_URL=https://demo-client.example.org
FRONTEND_URL=https://demo-client.example.org
BACKEND_URL=https://demo-client.example.org/api/v1

POSTGRES_USER=unityaid
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=unityaid
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
WORKER_QUEUE=default
WORKER_CONCURRENCY=2

BACKEND_PORT=8080
FRONTEND_PORT=8088

CORS_ALLOWED_ORIGINS=https://demo-client.example.org
VITE_API_BASE_URL=/api/v1

JWT_SECRET=change-me-long-random-secret
RUN_SEEDS=false
UPLOADS_DIR=/app/uploads

BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=UnityAid
BOOTSTRAP_ADMIN_PATRONYMIC=
BOOTSTRAP_ORGANIZATION_NAME=Demo organization
BOOTSTRAP_ORGANIZATION_SLUG=demo-organization

BACKUP_DIR=./backups
